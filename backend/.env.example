# Copy this to .env and fill in your values.
# Never commit .env to git.

# ── NVIDIA NIM — Primary receipt extraction provider ──────────────────────
# Model: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning (free endpoint)
# Get your API key at: https://build.nvidia.com/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_API_KEY=your_nvidia_api_key_here

# ── Google Gemini — Fallback receipt extraction provider ──────────────────
# Model: gemini-2.0-flash
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Mock mode (dev / testing) ─────────────────────────────────────────────
# Set either to "true" to skip all API calls and return a fake response.
# Useful for UI testing without spending tokens.
NVIDIA_RECEIPT_MOCK=false
GEMINI_RECEIPT_MOCK=false

# ── Django settings ───────────────────────────────────────────────────────
DJANGO_SECRET_KEY=fundvault-django-secret-change-in-production
JWT_SECRET=fundvault-jwt-secret-change-in-production
SESSION_HOURS=24
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
